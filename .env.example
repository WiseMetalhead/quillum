# Версия публичного образа. Для локальной сборки используется compose.build.yaml.
QUILLUM_IMAGE=ghcr.io/wisemetalhead/quillum:1.0.1
QUILLUM_VERSION=1.0.1
QUILLUM_PULL_POLICY=always

# Публичный HTTPS-адрес без пути, query и завершающего слеша.
QUILLUM_DOMAIN=write.example.org
QUILLUM_PUBLIC_ORIGIN=https://write.example.org

POSTGRES_DB=quillum
POSTGRES_USER=quillum

# Первый администратор создаётся только в пустой базе. Пароль генерирует scripts/public/init.sh.
QUILLUM_BOOTSTRAP_ADMIN_ENABLED=true
QUILLUM_BOOTSTRAP_ADMIN_USERNAME=admin
QUILLUM_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

QUILLUM_DJANGO_ADMIN_ENABLED=false
QUILLUM_COLLABORATION_MODE=enabled
QUILLUM_TRUSTED_PROXY_IPS=172.16.0.0/12

# Универсальный OpenID Connect. Client secret передавайте отдельным secret-файлом/overlay.
QUILLUM_OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_PROVIDER_NAME="OpenID Connect"

# Используется только с compose.external-proxy.yaml.
QUILLUM_HTTP_BIND=127.0.0.1
QUILLUM_HTTP_PORT=8080
